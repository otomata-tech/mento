#!/bin/bash
# audio-recorder - Record & transcribe meetings

set -o pipefail

# ─────────────────────────────────────────────────────────────────────────────
# Bootstrap
# ─────────────────────────────────────────────────────────────────────────────

SCRIPT_PATH="${BASH_SOURCE[0]}"
[ -L "$SCRIPT_PATH" ] && SCRIPT_PATH="$(readlink -f "$SCRIPT_PATH")"
LIB_DIR="$(cd "$(dirname "$SCRIPT_PATH")/lib" && pwd)"

# shellcheck source=lib/config.sh
source "$LIB_DIR/config.sh"
# shellcheck source=lib/utils.sh
source "$LIB_DIR/utils.sh"
# shellcheck source=lib/audio.sh
source "$LIB_DIR/audio.sh"
# shellcheck source=lib/transcribe.sh
source "$LIB_DIR/transcribe.sh"
# shellcheck source=lib/trim.sh
source "$LIB_DIR/trim.sh"
# shellcheck source=lib/library.sh
source "$LIB_DIR/library.sh"
# shellcheck source=lib/push.sh
source "$LIB_DIR/push.sh"

load_config

# ─────────────────────────────────────────────────────────────────────────────
# Dispatch
# ─────────────────────────────────────────────────────────────────────────────

cmd="$1"
shift
for arg in "$@"; do
    if [ "$arg" = "-h" ] || [ "$arg" = "--help" ]; then
        command_help "$cmd"
        exit 0
    fi
done

case "$cmd" in
    start)      cmd_start ;;
    pause)      cmd_pause ;;
    resume)     cmd_resume ;;
    stop)       cmd_stop "$@" ;;
    status)     cmd_status "$@" ;;
    tray)       exec python3 -I "$LIB_DIR/tray.py" "$SCRIPT_PATH" ;;
    transcribe) cmd_transcribe "$@" ;;
    trim|cut)   cmd_trim "$@" ;;
    list|ls)    cmd_list "$@" ;;
    show)       cmd_show "$@" ;;
    cat)        cmd_cat "$@" ;;
    search)     cmd_search "$@" ;;
    path)       cmd_path "$@" ;;
    rename)     cmd_rename "$@" ;;
    open)       cmd_open "$@" ;;
    push)       cmd_push "$@" ;;
    setup)      setup ;;
    help|--help|-h|"") show_help ;;
    *)          error "Unknown command: $cmd"; show_help; exit 1 ;;
esac
